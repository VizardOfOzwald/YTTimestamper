{
  "manifest_version": 3,
  "name": "YouTube Timestamp Looper",
  "description": "Create markers and loop YouTube playback between selected timestamps.",
  "version": "1.0.4",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-timestamp-looper@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Timestamp Looper",
    "default_popup": "popup.html"
  }
}
